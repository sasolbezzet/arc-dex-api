PORT=8787
NODE_ENV=development
AUTH_SECRET=
ENABLE_DEV_TOOLS=false
JSON_BODY_LIMIT=8mb

# Server-only Supabase persistence canary. Keep off until schema and dual-write
# tests pass; shadow/canary never exposes service_role to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_PERSISTENCE_MODE=off
# Transaction history uses Supabase as primary when persistence is enabled;
# set false to roll back reads to JSON while dual-write remains active.
SUPABASE_TX_HISTORY_READ_PRIMARY=true
# Invoice GET/status reads use Supabase as primary with JSON fallback.
SUPABASE_PAYMENT_INVOICE_READ_PRIMARY=true
# Invoice timeline reads use invoice_events when available; payment row timeline remains fallback.
SUPABASE_INVOICE_EVENTS_READ_PRIMARY=true
# x402 status/reconciliation reads use the Supabase cache with JSON fallback; on-chain verification remains authoritative.
SUPABASE_X402_INVOICE_READ_PRIMARY=true
# AI usage history reads use Supabase with JSON fallback; write path remains dual-write.
SUPABASE_AI_USAGE_READ_PRIMARY=true
# Webhook dedupe and auto-mint leases use Supabase RPCs when persistence is enabled;
# JSON/file-lock remains the availability fallback.
SUPABASE_OPERATIONAL_STATE_PRIMARY=true

# Protected server-only dApp runtime. Never place user EOA/Solana signer keys
# or local Hermes credentials here; those belong in ~/.arcox/agent.env.
ARC_RPC_URL=
ARC_CHAIN_ID=5042002
ETHEREUM_SEPOLIA_RPC=
BASE_SEPOLIA_RPC=
ARBITRUM_SEPOLIA_RPC=
GATEWAY_BALANCE_TIMEOUT_MS=7000
GATEWAY_PROXY_TIMEOUT_MS=40000
ARCSCAN_API_BASE_URL=https://testnet.arcscan.app/api/v2
ARC_MEMO_CONTRACT=0x5294E9927c3306DcBaDb03fe70b92e01cCede505
ERC8004_SCAN_LOOKBACK_BLOCKS=500000

TREASURY_MODE=unified_balance
ENABLE_UNIFIED_BALANCE=true
# Canonical payment recipient for platform fees, AI Router, x402, and status.
# Restart the backend after changing environment variables.
ARCOX_TREASURY_WALLET_ADDRESS=
ARCOX_SOLANA_TREASURY_ADDRESS=
DESTINATION_WALLET_ADDRESS=

# Verified MSCA CCTP ArcoxRouter addresses (frontend parity). These are the
# source router for each chain; destination mint always uses Circle CCTP
# MessageTransmitter.receiveMessage on the destination chain.
ARCOX_FEE_ROUTER_ADDRESS=0xDf800310443BEB589CEf91A09854203Ea36e43a7
ARCOX_BASE_FEE_ROUTER_ADDRESS=0x9425cC5b3C8B9e0FCb35beBdE737B4365A614Acc
ARCOX_ARBITRUM_FEE_ROUTER_ADDRESS=0x5dCAA895dDc7350cF0f9eb69E69536a4548b0cA7
ARCOX_FEE_RECIPIENT=
ARCOX_ROUTER_FEE_BPS=30
# Legacy settlement quote fallback only. Keep equal to ARCOX_ROUTER_FEE_BPS.
ARCOX_FEE_BPS=30
# Exact audited Circle stablecoin swap adapter used by MCP MSCA execution.
# Keep this equal to the deployed ARC_APPKIT_ADAPTER; do not set an AMM router.
ARCOX_SWAP_ADAPTER=0xBBD70b01a1CAbc96d5b7b129Ae1AAabdf50dd40b
# Audited on-chain AMM router used for USDC↔cirBTC MSCA swaps (ArcoxCirBTCRouterV2).
ARCOX_AMM_ROUTER=0x9f2443691bddd8343590c68e2a2cdec5fd0b6124
ARCOX_AMM_POOL=0xd4aF8e12903A4c6bD60BbC353fb97ffC9Cc2Dc2D

# Circle AppKit / developer-controlled wallet credentials. Server-only.
KIT_KEY=
CIRCLE_ENTITY_SECRET=
# Circle Modular Wallets credentials (different from CIRCLE_API_KEY).
# Create a Client Key in Circle Console → Keys → Create a key → Client Key,
# and bind the production web domain (arcoxdex.vercel.app) to that key.
CIRCLE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl
CIRCLE_CLIENT_KEY=
# Optional server-signed mint recovery. Keep disabled unless OWNER_PRIVATE_KEY
# is a dedicated testnet recovery signer and the endpoint is intentionally used.
ENABLE_SERVER_SIGNED_MINT=false
OWNER_PRIVATE_KEY=

X402_ENABLED=true
X402_MODE=arc_real_testnet
X402_ASSET=USDC
X402_CHAIN_ID=5042002
X402_USDC_ADDRESS=0x3600000000000000000000000000000000000000
X402_BASE_AMOUNT=0.005
X402_PAYMENT_TTL_SECONDS=300
CIRCLE_ENV=TEST
CIRCLE_BASE_URL=https://api-sandbox.circle.com
# Circle v2 Gateway public keys are fetched from the production notifications API.
# Override only when using an approved proxy or Circle endpoint override.
CIRCLE_WEBHOOK_API_BASE_URL=https://api.circle.com
CIRCLE_API_KEY=
# Circle webhooks are verified with X-Circle-Signature and X-Circle-Key-Id.
# The public verification key is fetched from Circle using CIRCLE_API_KEY.
CIRCLE_X402_TREASURY_WALLET_ID=
CIRCLE_X402_NETWORK=

ARKHAM_API_KEY=
ARKHAM_BASE_URL=https://api.arkm.com
ARCOX_INTEL_ENABLED=true
ARCOX_INTEL_CACHE_TTL_SECONDS=600

ARCOX_INTEL_PRICE_ADDRESS=0.005
ARCOX_INTEL_PRICE_ADDRESS_ALL=0.01
ARCOX_INTEL_PRICE_ADDRESS_ENRICHED=0.01
ARCOX_INTEL_PRICE_BALANCES=0.01
ARCOX_INTEL_PRICE_COUNTERPARTIES=0.02
ARCOX_INTEL_PRICE_FLOWS=0.03
ARCOX_INTEL_PRICE_HISTORY=0.03
ARCOX_INTEL_PRICE_VOLUME=0.03
ARCOX_INTEL_PRICE_TX=0.005
ARCOX_INTEL_PRICE_CONTRACT=0.01
ARCOX_INTEL_PRICE_ENTITY=0.02
ARCOX_INTEL_PRICE_TOKEN_BASIC=0.005
ARCOX_INTEL_PRICE_TOKEN_HOLDERS=0.03
ARCOX_INTEL_PRICE_REPORT_ADDRESS=0.05

AI_ROUTER_PUBLIC_BASE_URL=https://arcoxdex.vercel.app/v1
# MCP bridge auto-mint callback target. Set this to the backend/VPS public origin in production.
ARCOX_BACKEND_URL=https://43.134.14.43.nip.io
# CCTP V2 fee API is dynamic; never hardcode maxFee for Fast Transfers.
CCTP_FEE_API_BASE_URL=https://iris-api-sandbox.circle.com
CCTP_FEE_BUFFER_BPS=2000
AI_ROUTER_JSON_BODY_LIMIT=8mb
AI_ROUTER_DB=./ai-router-db.json
AI_ROUTER_DELEGATE_ADDRESS=
AI_ROUTER_DELEGATE_PRIVATE_KEY=
AI_ROUTER_SOLANA_DELEGATE_PRIVATE_KEY=
SOLANA_DEVNET_RPC=https://api.devnet.solana.com
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
CCTP_MAX_FEE_BASE_UNITS=10
CCTP_MIN_FINALITY_THRESHOLD=1000
# Explicit opt-in after route validation and destination MSCA authorization.
ENABLE_MSCA_CCTP_BRIDGE=false
AI_ROUTER_DEFAULT_COST_USDC=0.001
AI_ROUTER_MODEL_PRICE_DEFAULT_USDC=0.001
AI_ROUTER_MODEL_PRICES_USDC={"openai/gpt-oss-120b":"0.001","arcox/auto":"0.001"}
AI_ROUTER_IDEMPOTENCY_TTL_SECONDS=300
AI_ROUTER_MAX_SERVICE_COST_USDC=0.01
AI_ROUTER_MAX_TOTAL_DEBIT_USDC=0.25
AI_ROUTER_DAILY_LIMIT_USDC=10
AI_ROUTER_MONTHLY_LIMIT_USDC=0
AI_ROUTER_REQUESTS_PER_MINUTE=20
AI_ROUTER_DEFAULT_MONTHLY_LIMIT_USDC=2.00
UNIFIED_BALANCE_FEE_TOLERANCE_USDC=0.005
AI_PROVIDER_TIMEOUT_MS=45000
AI_ROUTER_ALLOW_MODEL_FALLBACK=true
AI_ROUTER_AUTO_MODEL=
AI_ROUTER_GATEWAY_TIMEOUT_MS=7000
AI_ROUTER_WALLET_QUEUE_TIMEOUT_MS=120000
AI_ROUTER_WALLET_LOCK_TTL_MS=180000
AI_PROVIDER_VALIDATE_MODELS=true
AI_PROVIDER_MODEL_CACHE_MS=600000
AI_PROVIDER_MODEL_TIMEOUT_MS=10000
AI_ROUTER_HTTP_REFERER=https://arcoxdex.vercel.app
AI_ROUTER_APP_TITLE=ARCOX AI Router
# Set false only for providers/models that reject OpenAI tools/tool_choice.
# Tool-capable providers are prioritized whenever Hermes sends tool schemas.
AI_PROVIDER_1_SUPPORTS_TOOLS=true
AI_PROVIDER_1_TIMEOUT_MS=20000
ARCOX_API_PASS_ADDRESS=0x56a948968125e37637a2875be0dc901357b184c0
ARCOX_API_CHALLENGE_TTL_SECONDS=300
ARCOX_API_SESSION_TTL_SECONDS=900

AI_PROVIDER_1_NAME=NVIDIA
AI_PROVIDER_1_BASE_URL=https://integrate.api.nvidia.com/v1
AI_PROVIDER_1_API_KEY=
AI_PROVIDER_1_MODEL=openai/gpt-oss-120b

AI_PROVIDER_2_NAME=NVIDIA
AI_PROVIDER_2_BASE_URL=https://integrate.api.nvidia.com/v1
AI_PROVIDER_2_API_KEY=
AI_PROVIDER_2_MODEL=nvidia/nemotron-3-super-120b-a12b
AI_PROVIDER_2_SUPPORTS_TOOLS=false

AI_PROVIDER_3_NAME=
AI_PROVIDER_3_BASE_URL=
AI_PROVIDER_3_API_KEY=
AI_PROVIDER_3_MODEL=
AI_PROVIDER_3_SUPPORTS_TOOLS=true

AI_PROVIDER_MIMO_API_KEYS=
